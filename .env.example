# Copy this file to ".env" and change the values. Never share the .env file.

# Where the PostgreSQL database is. Format: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# If the password has symbols such as @ # / : replace them with codes (for example @ becomes %40).
DATABASE_URL=postgres://pivot_app:CHANGE_ME@localhost:5432/pivot

# Hosted databases (Render, Neon, Supabase, AWS and others) usually need an encrypted connection:
# DATABASE_SSL=1

# Optional
# PORT=3000
# HOST=127.0.0.1
# NODE_ENV=production
# TRUST_PROXY=1
# SEED_SAMPLE=0
